{
  "manifest_version": 3,
  "name": "LinkedIn Recruiter CV Downloader",
  "version": "5.11",
  "description": "Downloads Recruiter resumes into Google Drive. Skips jobs with no new applicants and stops re-trying people who have no resume.",
  "key": "",
  "action": {
    "default_title": "Run LinkedIn Recruiter CV Downloader (to Google Drive)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "downloads",
    "storage",
    "identity",
    "contextMenus",
    "power"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://*.licdn.com/*",
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "276076835083-gmpri2h90v67ac5r57n8r9m2g3qne5kp.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "update_url": "https://juanroldangg.github.io/linkedin-recruiter-cv-downloader/updates.xml"
}
